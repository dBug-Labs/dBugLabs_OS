# dBugLabs_OS Configuration Example

# Admin Authentication
ADMIN_PASSWORD=change_this_to_a_secure_password_16_chars_min
SESSION_SECRET=super_secret_hmac_signing_key_for_dbos_sessions

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/dbuglabs_os
MONGODB_DB=dbuglabs_os

# SMTP Mail Delivery (Gmail App Password or Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=example@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="dBug Labs" <example@gmail.com>

# Outbox Cron Drain
CRON_SECRET=random_secure_cron_secret_string

# App Base URL for public verification QR codes & links
NEXT_PUBLIC_APP_URL=http://localhost:3000
